{
  "name": "8x-amazon-backend",
  "version": "1.0.0",
  "description": "Express.js REST API with Prisma & SQLite for ApexMart",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
